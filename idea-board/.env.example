# Telegram (обязательные)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
ADMIN_TELEGRAM_ID=123456789

# Auth (обязательный в production)
JWT_SECRET=random_secret_string_min_32_chars

# Webhook (обязательный — без него webhook не будет работать)
WEBHOOK_SECRET=random_secret_for_telegram_webhook

# App
NEXT_PUBLIC_APP_URL=https://ideas.olezhek28.courses
DATABASE_PATH=./data/ideas.db

# Limits (опциональные, указаны значения по умолчанию)
MAX_VOTES=5
REGEN_INTERVAL_HOURS=24
MONTHLY_IDEA_LIMIT=10
